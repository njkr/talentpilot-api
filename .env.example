# Copy to .env and fill in. Never commit real values.
# Variables are validated at boot (src/config/env.schema.ts); missing required ones are listed together.

#####################################
# Application
#####################################
NODE_ENV=development
PORT=3000
# Public URL of the frontend. Always allowed by CORS; used in email links and Stripe redirects.
APP_URL=http://localhost:3001
# Optional: extra CORS origins, comma-separated (e.g. a LAN address for device testing).
# CORS_ORIGINS=
# Optional: force cross-site cookie behaviour (SameSite=None; Secure) when the frontend and API
# are on different origins outside production, e.g. a tunnelled local API. Defaults to NODE_ENV === production.
# COOKIE_CROSS_SITE=false

#####################################
# PostgreSQL (needs the pgvector extension) and Redis
#####################################
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentpilot
DB_POOL_SIZE=10
# Optional: force TLS for Postgres. Defaults to NODE_ENV === production.
# DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

#####################################
# Auth
#####################################
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
RESET_TTL_MIN=30

#####################################
# Email (Resend)
#####################################
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@example.com

#####################################
# Object storage (S3-compatible: AWS S3, Cloudflare R2, or MinIO from docker-compose)
#####################################
# Omit S3_ENDPOINT for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=talentpilot-resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# true for MinIO
S3_FORCE_PATH_STYLE=true
# false for plain MinIO (no KMS); true for AWS S3 / R2
S3_SERVER_SIDE_ENCRYPTION=false
SIGNED_URL_TTL_SEC=900

#####################################
# Uploads
#####################################
MAX_FILE_SIZE_MB=10
MAX_RESUME_PAGES=15
MIN_EXTRACTED_CHARS=200

#####################################
# AI (OpenAI) and web search (Tavily)
#####################################
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
OPENAI_CONCURRENCY=5
AI_USER_DAILY_BUDGET_USD=2
AI_GLOBAL_DAILY_BUDGET_USD=50
# Set to true to stop all AI calls immediately.
AI_KILL_SWITCH=false
# Used for company research and salary estimates; those steps are optional and degrade gracefully.
TAVILY_API_KEY=tvly-your-tavily-api-key
# Credits granted to a new account.
SIGNUP_CREDIT_GRANT=100

#####################################
# Documents (PDF generation)
#####################################
# Only set in a container image that ships its own Chromium; leave unset locally.
# PUPPETEER_EXECUTABLE_PATH=

#####################################
# Payments (Stripe, test mode keys for development)
#####################################
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional: price ids seeded onto the plans table when migrations run.
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ULTIMATE=

#####################################
# Admin
#####################################
# Comma-separated emails allowed into /admin (in addition to role = admin).
ADMIN_ALLOWED_EMAILS=admin@example.com
